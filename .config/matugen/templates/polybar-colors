; temp/volume bg
cyan = {{colors.surface_container.default.hex}}

; text color
text = {{colors.on_surface.default.hex}}

; arch logo
arch = {{colors.primary.default.hex}}

; i3 icons
icons = {{colors.tertiary.default.hex}}

