#!/usr/bin/env bash
# screenshot: tira print (maim) — Print=full, Shift+Print=área, $MOD+Print=janela.
# Salva em ~/Pictures/Screenshots + copia p/ clipboard (xclip) + avisa no dunst.
# Todo caminho de falha avisa no dunst (sem morte silenciosa) e loga em ~/.cache/screenshot.log.
# Deps: maim (+ xdotool p/ janela ativa, xclip p/ clipboard). Instale:
#   sudo pacman -S maim xclip xdotool
set -euo pipefail
MODE="${1:-full}"
DIR="$HOME/Pictures/Screenshots"
LOG="$HOME/.cache/screenshot.log"

fail() {
  local msg="$1"
  printf '%s modo=%s erro=%s\n' "$(date '+%F %T')" "$MODE" "$msg" >>"$LOG" 2>/dev/null || true
  notify-send -u critical -t 5000 "screenshot" "$msg" 2>/dev/null || true
  echo "screenshot: $msg" >&2
  exit 1
}

mkdir -p "$DIR" || fail "não consegui criar $DIR"
mkdir -p "$(dirname "$LOG")" 2>/dev/null || true
FILE="$DIR/$(date +%Y%m%d_%H%M%S)_screenshot.png"

command -v maim >/dev/null 2>&1 || fail "maim não instalado: sudo pacman -S maim xclip xdotool"

case "$MODE" in
  full)
    maim "$FILE" 2>>"$LOG" || fail "maim falhou no modo full (ver ~/.cache/screenshot.log)"
    ;;
  area)
    # Esc cancela a mira (maim sai != 0 sem imagem): avisa em vez de morrer calado
    maim -s "$FILE" 2>>"$LOG" || fail "seleção cancelada ou inválida — arraste o mouse p/ marcar a área"
    ;;
  window)
    command -v xdotool >/dev/null 2>&1 || fail "xdotool não instalado: sudo pacman -S xdotool"
    wid="$(xdotool getactivewindow 2>>"$LOG")" || fail "não achei a janela ativa"
    maim -i "$wid" "$FILE" 2>>"$LOG" || fail "maim falhou na janela ativa (ver ~/.cache/screenshot.log)"
    ;;
  *) echo "Uso: screenshot [full|area|window]" >&2; exit 1 ;;
esac

if command -v xclip >/dev/null 2>&1; then
  xclip -selection clipboard -t image/png -i "$FILE" 2>/dev/null || true
  EXTRA=" (copiado p/ clipboard)"
else
  EXTRA=""
fi
notify-send -i "$FILE" "screenshot" "Salvo em $FILE$EXTRA" 2>/dev/null || true
echo "$FILE"
