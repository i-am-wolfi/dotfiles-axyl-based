#!/usr/bin/env bash
# MaterialYou para i3wm (estilo Noctalia/Monet): puxa cores do wallpaper via matugen.
# Uso: materialyou-set [wallpaper.jpg|jpeg|png|webp|gif|mp4|mkv|webm]  |  sem arg: usa wallpaper.* atual
# Gera: polybar/colors, dunstrc, alacritty/colors.yml+alacritty.toml, rofi-theme.rasi, i3 config (borders) + aplica tudo.
set -euo pipefail
# trava: dois picks rápidos seguidos não se atropelam no meio da geração
exec 9>"$HOME/.cache/materialyou-set.lock"
flock -n 9 || { echo "materialyou-set já rodando, aguarde..." >&2; exit 0; }
I3DIR="$HOME/.config/i3"
THEME="MaterialYou"
MATUGEN_BIN="$(command -v matugen || echo "$HOME/.local/bin/matugen")"

resolve_wall() {
    if [[ $# -ge 1 && -n "${1:-}" ]]; then echo "$1"; return 0; fi
    local ext f
    for ext in jpg jpeg png webp gif JPG JPEG PNG WEBP GIF; do
        f="$I3DIR/wallpaper.$ext"
        if [[ -f "$f" ]]; then echo "$f"; return 0; fi
    done
    echo "$I3DIR/wallpaper.jpg"
}
WALL="$(resolve_wall "${1:-}")"

if [[ ! -f "$WALL" ]]; then echo "Wallpaper não encontrado: $WALL" >&2; exit 1; fi
if [[ ! -x "$MATUGEN_BIN" ]]; then
  echo "matugen não encontrado. Instale: sudo pacman -S matugen" >&2
  exit 1
fi

# garante templates/config do repo no lugar (caso só o tema tenha sido copiado)
if [[ ! -f "$HOME/.config/matugen/config.toml" ]]; then
  for src in "$HOME/dotfiles/.config/matugen" "$I3DIR/themes/$THEME/matugen"; do
    if [[ -f "$src/config.toml" ]]; then mkdir -p "$HOME/.config/matugen"; cp -a "$src/." "$HOME/.config/matugen/"; break; fi
  done
fi

ext="${WALL##*.}"
ext="$(printf '%s' "$ext" | tr '[:upper:]' '[:lower:]')"
case "$ext" in
  jpg|jpeg|png|webp|gif) ;;
  mp4|mkv|webm)
    # vídeo: extrai 1 frame do meio p/ wallpaper.jpg (cores via matugen) e
    # o passo 3b toca o vídeo animado no fundo (precisa xwinwrap)
    command -v ffmpeg >/dev/null 2>&1 || { echo "ffmpeg não instalado: sudo pacman -S ffmpeg" >&2; exit 1; }
    ORIG_VIDEO="$WALL"
    IS_VIDEO=1
    DUR="$(ffprobe -v error -show_entries format=duration -of csv=p=0 "$WALL" 2>/dev/null || echo 6)"
    DUR_INT="${DUR%%.*}"
    [[ "$DUR_INT" =~ ^[0-9]+$ ]] || DUR_INT=6
    MID=$(( (DUR_INT + 1) / 2 ))
    FRAME="$(mktemp /tmp/opencode/muframe.XXXXXX.jpg)"
    ffmpeg -hide_banner -loglevel error -y -ss "$MID" -i "$WALL" -vframes 1 "$FRAME"
    WALL="$FRAME"; ext="jpg"
    ;;
  *) echo "Extensão não suportada: .$ext (use jpg/jpeg/png/webp/gif/mp4/mkv/webm)" >&2; exit 1 ;;
esac

# 1. normaliza wallpaper: webp -> png (feh pode não ler webp; matugen lê, mas feh é o gargalo)
if [[ "$ext" == "webp" ]]; then
  DEST="$I3DIR/wallpaper.png"
  if command -v ffmpeg >/dev/null 2>&1; then
    ffmpeg -hide_banner -loglevel error -y -i "$WALL" "$DEST"
  else
    cp -f "$WALL" "$DEST"
  fi
else
  DEST="$I3DIR/wallpaper.$ext"
  if [[ ! "$WALL" -ef "$DEST" ]]; then cp -f "$WALL" "$DEST"; fi
fi
# remove wallpapers obsoletos com outra extensão (evita fehbg ambíguo)
for old in "$I3DIR"/wallpaper.jpg "$I3DIR"/wallpaper.jpeg "$I3DIR"/wallpaper.png "$I3DIR"/wallpaper.webp "$I3DIR"/wallpaper.gif \
           "$I3DIR"/wallpaper.JPG "$I3DIR"/wallpaper.JPEG "$I3DIR"/wallpaper.PNG "$I3DIR"/wallpaper.WEBP "$I3DIR"/wallpaper.GIF; do
  if [[ "$old" != "$DEST" && -f "$old" ]]; then rm -f "$old"; fi
done
dname="$(basename "$DEST")"
printf '#!/bin/sh\nfeh --bg-fill ~/.config/i3/%s\n' "$dname" > "$I3DIR/fehbg"
chmod +x "$I3DIR/fehbg"
if command -v feh >/dev/null; then feh --bg-fill "$DEST" 2>/dev/null || true; fi

# 2. gera cores (dark, tonal-spot = Monet padrão; vibrant: -t scheme-vibrant)
"$MATUGEN_BIN" image "$DEST" -m dark --source-color-index 0 2>&1 | tail -n 3 || true

# 3. espelha resultado no tema (para git + theme-switch não perder)
if [[ -d "$I3DIR/themes/$THEME" ]]; then
  for f in polybar/colors dunstrc "alacritty/colors.yml" "alacritty/alacritty.toml" rofi-theme.rasi config fehbg; do
    if [[ -f "$I3DIR/$f" ]]; then cp -f "$I3DIR/$f" "$I3DIR/themes/$THEME/$f"; fi
  done
  for old in "$I3DIR/themes/$THEME"/wallpaper.jpg "$I3DIR/themes/$THEME"/wallpaper.jpeg \
             "$I3DIR/themes/$THEME"/wallpaper.png "$I3DIR/themes/$THEME"/wallpaper.webp "$I3DIR/themes/$THEME"/wallpaper.gif; do
    if [[ "$old" != "$I3DIR/themes/$THEME/$dname" && -f "$old" ]]; then rm -f "$old"; fi
  done
  cp -f "$DEST" "$I3DIR/themes/$THEME/$dname"
  # rasi compartilhado do rofi (~/.config/rofi, fora do i3): backup no tema
  mkdir -p "$I3DIR/themes/$THEME/rofi"
  cp -f "$HOME/.config/rofi/theme.rasi" "$I3DIR/themes/$THEME/rofi/theme.rasi" 2>/dev/null || true
fi

# 3b. fundo animado: vídeo/gif toca via mpv (xwinwrap); imagem estática
# para qualquer vídeo anterior (gif conta como vídeo: feh só mostra 1 frame).
# NOTA: testa IS_VIDEO (ext foi reescrito p/ jpg após extrair o frame)
if [[ "${IS_VIDEO:-0}" == 1 || "$ext" == "gif" ]]; then
  SRC_VID="${ORIG_VIDEO:-$WALL}"
  if command -v xwinwrap >/dev/null 2>&1; then
    # 9>&-: player em loop herdaria o fd do flock e travaria o próximo pick p/ sempre
    "$I3DIR/bin/video-wallpaper" start "$SRC_VID" 9>&- >/dev/null 2>&1 || true
  else
    notify-send -t 5000 "wallpaper animado" "Frame aplicado; instale xwinwrap-git p/ animar (pikaur -S xwinwrap-git)" 2>/dev/null || true
  fi
else
  "$I3DIR/bin/video-wallpaper" stop >/dev/null 2>&1 || true
fi

# 4. recarrega tudo (dunst via reload no mesmo processo: o pkill+start antigo
# disputava o bus e um dunst sem -config assumia com cores padrão)
i3-msg restart >/dev/null 2>&1 || true
bash "$I3DIR/bin/launchbar.sh" 9>&- >/dev/null 2>&1 &
if ! dunstctl reload >/dev/null 2>&1; then
  pkill -x dunst 2>/dev/null || true
  sleep 1
  setsid dunst -config "$I3DIR/dunstrc" >/dev/null 2>&1 < /dev/null &
fi
echo "MaterialYou aplicado de: $WALL -> $DEST"
