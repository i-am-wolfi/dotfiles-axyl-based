#!/usr/bin/env bash
# MaterialYou para i3wm (estilo Noctalia/Monet): puxa cores do wallpaper via matugen.
# Uso: materialyou-set [wallpaper]  |  sem arg: usa ~/.config/i3/wallpaper.jpg
# Gera: polybar/colors, dunstrc, alacritty/colors.yml, i3 config (borders) + aplica tudo.
set -euo pipefail
I3DIR="$HOME/.config/i3"
THEME="MaterialYou"
WALL="${1:-$I3DIR/wallpaper.jpg}"
MATUGEN_BIN="$(command -v matugen || echo "$HOME/.local/bin/matugen")"

if [[ ! -f "$WALL" ]]; then echo "Wallpaper não encontrado: $WALL" >&2; exit 1; fi
if [[ ! -x "$MATUGEN_BIN" ]]; then
  echo "matugen não encontrado. Instale: sudo pacman -S matugen" >&2
  echo "(ou baixe em https://github.com/InioX/matugen/releases -> ~/.local/bin/matugen)" >&2
  exit 1
fi

# garante templates/config do repo no lugar (caso só o tema tenha sido copiado)
if [[ -d "$HOME/dotfiles/.config/matugen" && ! -f "$HOME/.config/matugen/config.toml" ]]; then
  mkdir -p "$HOME/.config/matugen"; cp -a "$HOME/dotfiles/.config/matugen/." "$HOME/.config/matugen/"
fi

# 1. wallpaper
cp -f "$WALL" "$I3DIR/wallpaper.jpg"
if command -v feh >/dev/null; then feh --bg-fill "$I3DIR/wallpaper.jpg"; fi
[[ -f "$I3DIR/fehbg" ]] && sed -i "s|^feh .*|feh --bg-fill ~/.config/i3/wallpaper.jpg|" "$I3DIR/fehbg" || true

# 2. gera cores (dark, tonal-spot = Monet padrão; vibrant: -t scheme-vibrant)
"$MATUGEN_BIN" image "$I3DIR/wallpaper.jpg" -m dark --source-color-index 0 2>&1 | tail -n 3 || true

# 3. espelha resultado no tema (para git + theme-switch não perder)
for f in polybar/colors dunstrc "alacritty/colors.yml" config; do
  if [[ -f "$I3DIR/$f" && -d "$I3DIR/themes/$THEME" ]]; then cp -f "$I3DIR/$f" "$I3DIR/themes/$THEME/$f"; fi
done
cp -f "$I3DIR/wallpaper.jpg" "$I3DIR/themes/$THEME/wallpaper.jpg" 2>/dev/null || true

# 4. recarrega tudo
i3-msg restart >/dev/null 2>&1 || true
bash "$I3DIR/bin/launchbar.sh" >/dev/null 2>&1 &
pkill dunst 2>/dev/null || true
setsid dunst >/dev/null 2>&1 < /dev/null &
echo "MaterialYou aplicado de: $WALL"
